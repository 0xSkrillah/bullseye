# Copy to .env and fill in. .env is git-ignored; never commit real values.

PORT=4402
PUBLIC_BASE_URL=http://localhost:4402
DB_PATH=./data/bullseye.sqlite

# --- data sources -----------------------------------------------------------
# live      xStocks public API + X Layer mainnet RPC (no keys needed)
# recorded  replay artifacts/recorded/* ; everything is labelled HISTORICAL
# fixture   synthetic test data ; everything is labelled FIXTURE
DATA_SOURCE=live
RECORDING_DIR=./artifacts/recorded/xstocks-2026-09-18
XSTOCKS_BASE_URL=https://api.xstocks.fi/api/v2
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech

# --- investigator -----------------------------------------------------------
# openrouter | anthropic | fixture (fixture is a test double; its Briefs are labelled FIXTURE and the gate refuses to publish them unless ALLOW_FIXTURE_PUBLICATION=true)
SYNTHESIS_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Auto Router cost tier: low | medium | high | xhigh | max
OPENROUTER_COST_TIER=medium
# hard price caps, USD per million tokens. No request is routed to a dearer endpoint,
# and the research budget is enforced against these figures.
OPENROUTER_MAX_PRICE_PROMPT=3
OPENROUTER_MAX_PRICE_COMPLETION=15
# defaults to openrouter/auto (or claude-opus-5 with SYNTHESIS_PROVIDER=anthropic).
# openrouter/auto-beta and any vendor/model id on OpenRouter also work.
# BULLSEYE_MODEL=openrouter/auto
# only for SYNTHESIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
BUDGET_MAX_COST_USD=0.60
BUDGET_MAX_MODEL_CALLS=6
BUDGET_MAX_TOOL_CALLS=14
BUDGET_MAX_LATENCY_MS=180000
BUDGET_MAX_OUTPUT_TOKENS=8000

# --- commerce ---------------------------------------------------------------
# okx-testnet  X Layer testnet (eip155:1952) through the OKX x402 facilitator
# okx-mainnet  X Layer mainnet (eip155:196)
# fixture      signatures are verified locally, nothing touches a chain (tests)
PAYMENT_RAIL=okx-testnet
# OKX developer portal credentials: https://web3.okx.com/onchainos/dev-portal
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# wallet that receives payments
PAY_TO_ADDRESS=
BRIEF_PRICE_USD=3.00
QUOTE_TTL_SECONDS=900

# --- unattended operation (docs/DEPLOYMENT.md) --------------------------------
# Scan and investigate on a timer with no operator. Off by default: every
# investigation it starts spends money. It investigates a signal at most once,
# one at a time, and never more than the daily ceiling; worst-case model spend
# per 24 h is the ceiling times BUDGET_MAX_COST_USD ($1.80 at these defaults).
AUTO_DESK=false
AUTO_DESK_INTERVAL_MINUTES=30
AUTO_DESK_MAX_INVESTIGATIONS_PER_DAY=3

# planning allowances per order, USD. These are estimates and are always shown as such.
EST_PAYMENT_FEE_RESERVE_USD=0.15
EST_REWORK_RESERVE_USD=0.20
EST_DATA_TOOL_ALLOWANCE_USD=0.10

# --- agent buyer (scripts/buy-brief.ts) ------------------------------------
# a throwaway X Layer TESTNET key (64 hex characters, with or without 0x) funded from
# https://www.okx.com/xlayer/faucet/xlayerfaucet ; check it with `npm run wallet`
BUYER_PRIVATE_KEY=

# tests only
ALLOW_FIXTURE_PUBLICATION=false
