{
  "name": "bullseye",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous intelligence desk for tokenised markets",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w @bullseye/api\" \"npm run dev -w @bullseye/web\"",
    "dev:api": "npm run dev -w @bullseye/api",
    "dev:web": "npm run dev -w @bullseye/web",
    "build": "npm run build -w @bullseye/web",
    "start": "npm run start -w @bullseye/api",
    "typecheck": "tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run && npm run test:web",
    "test:e2e": "playwright test",
    "spike": "tsx --env-file-if-exists=.env scripts/spike.ts",
    "detect": "tsx --env-file-if-exists=.env scripts/detect.ts",
    "buy": "tsx --env-file-if-exists=.env scripts/buy-brief.ts",
    "verify-payment": "tsx --env-file-if-exists=.env scripts/verify-payment.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/run-demo.ts",
    "record": "tsx --env-file-if-exists=.env scripts/record.ts",
    "start:offline": "npm run start:offline -w @bullseye/api",
    "test:web": "vitest run --root apps/web",
    "wallet": "tsx --env-file-if-exists=.env scripts/wallet-check.ts",
    "model-check": "tsx --env-file-if-exists=.env scripts/model-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
